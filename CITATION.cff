cff-version: 1.2.0
message: >-
  If you use singlet.bio data, cite the original study of every dataset you use
  (its paper and GEO accession) and singlet.bio as below, with the date you
  downloaded the data. Text, BibTeX and RIS: https://singlet.bio/about#cite
title: "singlet.bio: an open atlas of public single-cell RNA-seq studies reprocessed from raw reads"
type: dataset
authors:
  - family-names: DeBruine
    given-names: Zachary
    affiliation: "Grand Valley State University"
version: "Singlet Research Alpha (October 2026)"
url: "https://singlet.bio"
repository-code: "https://github.com/zdebruine/singlet-website"
license: CC0-1.0
keywords:
  - single-cell RNA-seq
  - atlas
  - GEO
references:
  - type: software
    title: "singlet: Python, R and C++ client and engine for singlet.bio"
    authors:
      - family-names: DeBruine
        given-names: Zachary
    url: "https://github.com/Singlet-Bio/singlet"
    license: MIT

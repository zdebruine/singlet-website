{
  "name": "singlet_import_matrix",
  "title": "Import a count matrix",
  "description": "Convert a Matrix Market (.mtx/.mtx.gz), SciPy sparse (.npz) or an existing block file into the workspace. Counts must be non-negative integers below 65536.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Dataset name."
      },
      "path": {
        "type": "string",
        "description": "Path to the matrix file."
      },
      "format": {
        "type": "string",
        "description": "File format.",
        "default": "auto",
        "enum": [
          "auto",
          "mtx",
          "npz",
          "sblk"
        ]
      },
      "orientation": {
        "type": "string",
        "description": "Axis order in the file.",
        "default": "cells_by_genes",
        "enum": [
          "cells_by_genes",
          "genes_by_cells"
        ]
      },
      "genes_path": {
        "type": "string",
        "description": "Optional text file with one gene name per line."
      },
      "block_cells": {
        "type": "integer",
        "description": "Cells per stored block.",
        "default": 16384
      }
    },
    "required": [
      "name",
      "path"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ]
      },
      "summary": {
        "type": "string"
      },
      "metrics": {
        "type": "object"
      },
      "figures": {
        "type": "array"
      },
      "artifacts": {
        "type": "array"
      },
      "warnings": {
        "type": "array"
      },
      "next": {
        "type": "array"
      },
      "timings": {
        "type": "object"
      }
    },
    "required": [
      "status",
      "summary"
    ]
  },
  "_meta": {
    "singlet": {
      "task_id": "harmonization.object_integrity_checks",
      "reads": [],
      "writes": [],
      "runtime": "local-cpu",
      "streaming": true
    }
  }
}
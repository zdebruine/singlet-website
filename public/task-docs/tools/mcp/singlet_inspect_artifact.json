{
  "name": "singlet_inspect_artifact",
  "title": "Inspect a stored array",
  "description": "Debug view of any stored array: shape, dtype, finite fraction, quantiles, a small head, and for label arrays the group counts. Use it to check an intermediate result before the next step.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Dataset name."
      },
      "key": {
        "type": "string",
        "description": "Array key (omit to list all arrays)."
      },
      "head": {
        "type": "integer",
        "description": "Rows shown from the start.",
        "default": 5
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ]
      },
      "summary": {
        "type": "string"
      },
      "metrics": {
        "type": "object"
      },
      "figures": {
        "type": "array"
      },
      "artifacts": {
        "type": "array"
      },
      "warnings": {
        "type": "array"
      },
      "next": {
        "type": "array"
      },
      "timings": {
        "type": "object"
      }
    },
    "required": [
      "status",
      "summary"
    ]
  },
  "_meta": {
    "singlet": {
      "task_id": "harmonization.object_integrity_checks",
      "reads": [],
      "writes": [],
      "runtime": "local-cpu",
      "streaming": true
    }
  }
}